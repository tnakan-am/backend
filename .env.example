# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
# If using `docker-compose up`, host=localhost, port=5433 (mapped from 5432 in the container).
# If using a local Postgres, port=5432.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=homemade

# --- Auth ---
# Any random 32+ char secret for local dev. In prod, set a real strong secret.
JWT_SECRET=replace-me-with-a-long-random-string

# --- CORS ---
# Comma-separated origins the API will accept. Angular default dev server is :4200.
CORS_ORIGIN=http://localhost:4200

# --- Frontend ---
# Used to build verification + password-reset links emailed to the user.
FRONTEND_URL=http://localhost:4200

# --- SMTP (email verification + password reset) ---
# For dev: get free creds at https://ethereal.email (preview URL logged for every send).
# For Gmail: SMTP_USER=you@gmail.com, SMTP_PASS=<App Password>, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tnakan.local

# --- Uploads ---
# Where multer writes uploaded files on disk. Relative to project root.
UPLOADS_DIR=uploads
# Public base URL the API serves uploaded files at. Usually <api host>/uploads.
UPLOADS_PUBLIC_URL=http://localhost:3000/uploads
